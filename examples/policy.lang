-- The policy words (S6, PLAN sections 4.1 and 4.2, design sections 4 and 5), guest mode.
-- The design policy p0: one class of 4 parties, f = 1, the authorize bar t = 3
-- and the amend bar t = 3. p1 has the amend bar t = 4 (G3).
def one : Size := szS sz0
def two : Size := szS one
def three : Size := szS two
def four : Size := szS three
def yes : Decision := inr unit
def no : Decision := inl unit
def k3 : Pos (szS four) := posNext four (posNext three (posNext two (posFirst one)))
def k4 : Pos (szS four) := posNext four (posNext three (posNext two (posNext one (posFirst sz0))))
def fig : Committee := cmClass four cmNil
def maj : Rule fig := rlMin fig (ctClass four cmNil k3 ctNil)
def all4 : Rule fig := rlMin fig (ctClass four cmNil k4 ctNil)
def majHonest : Honest fig one := hoRule fig one maj
def majFork : ForkFree fig one := ffRule fig one maj
def allFork : ForkFree fig one := ffRule fig one all4
def p0 : Policy := plOf fig one majHonest majFork
def p1 : Policy := plOf fig one majHonest allFork
-- Approval sets: all 4 parties, and no party.
def s4 : Approvals fig := apClass four cmNil (fun (p : Pos four) => yes) apNil
def s0 : Approvals fig := apClass four cmNil (fun (p : Pos four) => no) apNil
-- O2: each decision is binary.
def okAuth : Decision := authorize p0 Unit unit s4
def noAuth : Decision := authorize p0 Unit unit s0
def o2Yes : Path Decision okAuth yes := refl
def o2No : Path Decision noAuth no := refl
-- One amendment p0 -> p1 by 4 approvals, and a log of one entry.
def am01 : Amendment p0 p1 := amOf p0 p1 s4 refl
def log01 : Log p0 p1 := lgCons p0 p1 p1 am01 (lgNil p1)
-- TCM-E on a closed log.
def eNilL : Path (Log p0 p1) (append p0 p0 p1 (lgNil p0) log01) log01 := appendNilL p0 p1 log01
def eNilR : Path (Log p0 p1) (append p0 p1 p1 log01 (lgNil p1)) log01 := appendNilR p0 p1 log01
def eAssoc : Path (Log p0 p1) (append p0 p1 p1 log01 (append p1 p1 p1 (lgNil p1) (lgNil p1))) (append p0 p1 p1 (append p0 p1 p1 log01 (lgNil p1)) (lgNil p1)) := appendAssoc p0 p1 p1 p1 log01 (lgNil p1) (lgNil p1)
-- O10: p0 at height 0, p1 at height 1, and p1 past the end of the log.
def h0 : Pos two := posFirst one
def h1 : Pos two := posNext one (posFirst sz0)
def o10At0 : Path Policy (policyAt p0 p1 log01 h0) p0 := refl
def o10At1 : Path Policy (policyAt p0 p1 log01 h1) p1 := refl
def o10Past : Path Policy (sHead Policy (sTail Policy (sTail Policy (sTail Policy (systemOf p0 p1 log01))))) p1 := refl
-- A count vector that gives a Decision passes REFUSE_ARROW.
def figDecide : Counts fig -> Decision := fun (w : Counts fig) => accept fig maj w
