-- The domain file. The kernel port (S2, a port of permit-lang 3d47120) removes
-- the kit sample and adds the kernel prelude. The ratify-lang domain words
-- come in a later slice.
-- Each family, constructor, field and def name here becomes a core name
-- (rule R4). Only this file can declare a family (rule R1).

-- Kan library (ported from sealed-lang, R6 (a)): transport, subst, J and the
-- J rule as a path (JRefl, sealed-lang O11), all by transp.
def transport : (X : Type 0) -> (Y : Type 0) -> Path (Type 0) X Y -> X -> Y :=
  fun (X : Type 0) => fun (Y : Type 0) => fun (p : Path (Type 0) X Y) => fun (a : X) => transp (fun (i : I) => p @ i) i0 a
def subst : (A : Type 0) -> (B : A -> Type 0) -> (x : A) -> (y : A) -> Path A x y -> B x -> B y :=
  fun (A : Type 0) => fun (B : A -> Type 0) => fun (x : A) => fun (y : A) => fun (p : Path A x y) => fun (b : B x) =>
    transp (fun (i : I) => B (p @ i)) i0 b
def J : (A : Type 0) -> (x : A) -> (P : (y : A) -> Path A x y -> Type 0) -> P x refl -> (y : A) -> (p : Path A x y) -> P y p :=
  fun (A : Type 0) => fun (x : A) => fun (P : (y : A) -> Path A x y -> Type 0) => fun (d : P x refl) => fun (y : A) => fun (p : Path A x y) =>
    transp (fun (i : I) => P (p @ i) (fun (j : I) => p @ (i /\ j))) i0 d
def JRefl : (A : Type 0) -> (x : A) -> (P : (y : A) -> Path A x y -> Type 0) -> (d : P x refl) -> Path (P x refl) (J A x P d x refl) d :=
  fun (A : Type 0) => fun (x : A) => fun (P : (y : A) -> Path A x y -> Type 0) => fun (d : P x refl) =>
    fun (i : I) => transp (fun (_ : I) => P x refl) i d
-- Path composition (S2b, R2 (a)): trans by hcomp, with the tube x on ~j
-- and q on j, and the base p.
def trans : (A : Type 0) -> (x : A) -> (y : A) -> (z : A) -> Path A x y -> Path A y z -> Path A x z :=
  fun (A : Type 0) => fun (x : A) => fun (y : A) => fun (z : A) => fun (p : Path A x y) => fun (q : Path A y z) =>
    fun (j : I) => hcomp A (~j \/ j) (fun (i : I) => [ ~j -> x, j -> q @ i ]) (p @ j)
-- Propositions and sets (S4b): the squash1 fold case has the type
-- isProp RES, the squash0 fold case the type isSet RES.
def isProp : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => (x : A) -> (y : A) -> Path A x y
def isSet : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => (x : A) -> (y : A) -> isProp (Path A x y)

-- The circle, a higher inductive family (S4a, R1 (a)). The path
-- constructor loop goes from base to base.
family S1 := base | loop (i : I) [ ~i -> base, i -> base ]
-- The propositional truncation (S4b, R5 (a)): squash1 is a path between
-- any two points, so the squash1 fold case has the type isProp RES. A
-- field name is a core name (rule R4), so the names have a family prefix.
family Trunc1 (A : Type 0) := trunc1 (truncOf : A) | squash1 (squashFrom : Trunc1 A) (squashTo : Trunc1 A) (i : I) [ ~i -> squashFrom, i -> squashTo ]
-- The set truncation (S4c, R5 (a)): squash0 is a square between any two
-- paths with the same ends, so the squash0 fold case has the type isSet
-- RES (R8 (a)). The case binds the folded ends and the folded paths.
family Trunc0 (A : Type 0) := trunc0 (trunc0Of : A) | squash0 (squash0From : Trunc0 A) (squash0To : Trunc0 A) (squash0Left : Path (Trunc0 A) squash0From squash0To) (squash0Right : Path (Trunc0 A) squash0From squash0To) (i : I) (j : I) [ ~i -> squash0Left @ j, i -> squash0Right @ j, ~j -> squash0From, j -> squash0To ]
-- The set quotient Quot went in S3 (rule R1: its relation parameter is a
-- value parameter, so it is not a cell signature). The quotients of the
-- DAO are families with no parameter: Orbit, Parity and OrbitN.
-- The size index (S6, O24, USER ruling S6): a domain family, so Nat
-- stays internal.
family Size := sz0 | szS (szPred : Size)
-- The stream comonad (S4, O28): the cofree comonad of the cocell
-- signature with the observation sHead and the cofield sTail. The checker
-- elaborates it (choice (ii)) to the positions Stream.pos, Stream A :=
-- Stream.pos -> A, the destructors sHead and sTail, the walk Stream.walk,
-- the corecursor sCorec and the bisimulation principle StreamBisim.
cofamily Stream (A : Type 0) := sCorec (sHead : A) (sTail : Stream A)
-- Extend and duplicate: sExtend A B f is the corecursor at the seed type
-- Stream A, with the observation f and the step sTail A.
def sExtend : (A : Type 0) -> (B : Type 0) -> (Stream A -> B) -> Stream A -> Stream B :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : Stream A -> B) => sCorec B (Stream A) f (sTail A)
def sDuplicate : (A : Type 0) -> Stream A -> Stream (Stream A) :=
  fun (A : Type 0) => sExtend A (Stream A) (fun (x : Stream A) => x)
-- The parity quotient of Size (S3, design C 2b, USER ruling Q-S3-8 (a)):
-- sizeEven s is sz0 for an even s and szS sz0 for an odd s, and parityEq
-- is a path from parityOf a to parityOf b when a and b have the same
-- parity. The relation is in the field type, so Parity has no parameter.
-- paritySquash has the squash0 shape, so its fold case has the type isSet
-- RES.
def sizeFlip : Size -> Size := fun (s : Size) => elim (fun (t : Size) => Size) (szS sz0) (fun (k : Size) (ih : Size) => sz0) s
def sizeEven : Size -> Size := fun (s : Size) => fold sz0 (fun (r : Size) => sizeFlip r) s
family Parity := parityOf (parityAt : Size)
  | parityEq (parityA : Size) (parityB : Size) (parityR : Path Size (sizeEven parityA) (sizeEven parityB)) (i : I) [ ~i -> parityOf parityA, i -> parityOf parityB ]
  | paritySquash (parityFrom : Parity) (parityTo : Parity) (parityLeft : Path Parity parityFrom parityTo) (parityRight : Path Parity parityFrom parityTo) (i : I) (j : I)
    [ ~i -> parityLeft @ j, i -> parityRight @ j, ~j -> parityFrom, j -> parityTo ]
-- The empty family (S10 B1, USER ruling Q-S10-9 (a)): one constructor and
-- no base case, so no closed value. The parser needs a constructor, so
-- Empty is not a family with no constructor (the Q-S10-4 (a) probe).
family Empty := emptyLoop (emptyOf : Empty)
-- The bag (S3, design C section 3, rule R1): the free commutative monoid
-- on A. bagOf is the generator, bagUnit the unit and bagOp the operation;
-- bagAssoc, bagComm and bagUnitL are the monoid paths (the right unit
-- follows from bagComm), and bagSquash in the form of Trunc0 squash0
-- makes it a set. A occurs only in the generator field. It was an
-- indexed HIT of lists up to a swap (S6, O20): a Size field and an
-- indexed bagOp have no comm path.
family Bag (A : Type 0) := bagOf (bagGen : A)
  | bagUnit
  | bagOp (opLeft : Bag A) (opRight : Bag A)
  | bagAssoc (assocX : Bag A) (assocY : Bag A) (assocZ : Bag A) (i : I)
    [ ~i -> bagOp A (bagOp A assocX assocY) assocZ, i -> bagOp A assocX (bagOp A assocY assocZ) ]
  | bagComm (commX : Bag A) (commY : Bag A) (i : I)
    [ ~i -> bagOp A commX commY, i -> bagOp A commY commX ]
  | bagUnitL (unitX : Bag A) (i : I)
    [ ~i -> bagOp A (bagUnit A) unitX, i -> unitX ]
  | bagSquash (bagFrom : Bag A) (bagTo : Bag A) (bagLeft : Path (Bag A) bagFrom bagTo) (bagRight : Path (Bag A) bagFrom bagTo) (i : I) (j : I)
    [ ~i -> bagLeft @ j, i -> bagRight @ j, ~j -> bagFrom, j -> bagTo ]
-- The free monoid (S3, USER ruling Q-S3-5 (a), rule R1): the cell monad
-- of the monoid signature, with the generator fmEta and a set squash. The
-- cons list List is kit only (the host ABI); a guest List gives REFUSE_CELL,
-- and a guest program uses FreeMon. The bind is the fold (fmFold).
family FreeMon (A : Type 0) := fmEta (fmEtaOf : A)
  | fmUnit
  | fmMul (fmLeft : FreeMon A) (fmRight : FreeMon A)
  | fmAssoc (fmAssocX : FreeMon A) (fmAssocY : FreeMon A) (fmAssocZ : FreeMon A) (i : I)
    [ ~i -> fmMul A (fmMul A fmAssocX fmAssocY) fmAssocZ, i -> fmMul A fmAssocX (fmMul A fmAssocY fmAssocZ) ]
  | fmUnitL (fmUnitLOf : FreeMon A) (i : I)
    [ ~i -> fmMul A (fmUnit A) fmUnitLOf, i -> fmUnitLOf ]
  | fmUnitR (fmUnitROf : FreeMon A) (i : I)
    [ ~i -> fmMul A fmUnitROf (fmUnit A), i -> fmUnitROf ]
  | fmSquash (fmFrom : FreeMon A) (fmTo : FreeMon A) (fmPathL : Path (FreeMon A) fmFrom fmTo) (fmPathR : Path (FreeMon A) fmFrom fmTo) (i : I) (j : I)
    [ ~i -> fmPathL @ j, i -> fmPathR @ j, ~j -> fmFrom, j -> fmTo ]
def fmCons : (A : Type 0) -> A -> FreeMon A -> FreeMon A :=
  fun (A : Type 0) (a : A) (xs : FreeMon A) => fmMul A (fmEta A a) xs
def fmIsSet : (A : Type 0) -> isSet (FreeMon A) :=
  fun (A : Type 0) (x : FreeMon A) (y : FreeMon A) (p : Path (FreeMon A) x y) (q : Path (FreeMon A) x y) => fun (i : I) => fun (j : I) => fmSquash A x y p q i j
-- The universal property: a map from A into a monoid M that is a set
-- extends to FreeMon A. The fold cases are the laws of M.
def fmFold : (A : Type 0) -> (M : Type 0) -> isSet M -> (e : M) -> (op : M -> M -> M) -> ((x : M) -> (y : M) -> (z : M) -> Path M (op (op x y) z) (op x (op y z))) -> ((x : M) -> Path M (op e x) x) -> ((x : M) -> Path M (op x e) x) -> (A -> M) -> FreeMon A -> M :=
  fun (A : Type 0) (M : Type 0) (s : isSet M) (e : M) (op : M -> M -> M) (assoc : (x : M) -> (y : M) -> (z : M) -> Path M (op (op x y) z) (op x (op y z))) (unitL : (x : M) -> Path M (op e x) x) (unitR : (x : M) -> Path M (op x e) x) (f : A -> M) (t : FreeMon A) =>
    fold (fun (a : A) => f a) e (fun (x : M) (y : M) => op x y)
      (fun (x : M) (y : M) (z : M) => fun (i : I) => assoc x y z @ i)
      (fun (x : M) => fun (i : I) => unitL x @ i)
      (fun (x : M) => fun (i : I) => unitR x @ i)
      (fun (x : M) (y : M) (p : Path M x y) (q : Path M x y) => fun (i : I) => fun (j : I) => (s x y p q @ i) @ j) t
def fmBind : (A : Type 0) -> (B : Type 0) -> (A -> FreeMon B) -> FreeMon A -> FreeMon B :=
  fun (A : Type 0) (B : Type 0) (k : A -> FreeMon B) => fmFold A (FreeMon B) (fmIsSet B) (fmUnit B) (fmMul B)
    (fun (x : FreeMon B) (y : FreeMon B) (z : FreeMon B) => fun (i : I) => fmAssoc B x y z i)
    (fun (x : FreeMon B) => fun (i : I) => fmUnitL B x i)
    (fun (x : FreeMon B) => fun (i : I) => fmUnitR B x i) k
def fmMap : (A : Type 0) -> (B : Type 0) -> (A -> B) -> FreeMon A -> FreeMon B :=
  fun (A : Type 0) (B : Type 0) (f : A -> B) => fmBind A B (fun (a : A) => fmEta B (f a))
-- The trace position (S3, USER ruling Q-S3-3 (a)): a position is an op
-- count. `len A r` is a C builtin (OP_FM_LEN): the domain cannot prove the
-- Nat monoid laws that fmFold needs (S3 survey section 7).
def OpPos : Type 0 := Nat
-- S9 (Q-S9-8 (a)): a byte operand of a host import, the OFF and LEN of the
-- bytes in the Wasm memory. The lowering gives the two fields as two params.
def Bytes : Type 0 := Prod Nat Nat
-- The positions of a bag (S7 B3, Q4): Pos n has n values, the first
-- position at each szS and a lift of each position of the tail. No
-- constructor gives Pos sz0. A domain family, so Fin stays internal (O23).
family Pos : Size -> Type 0 := posFirst (firstSize : Size) : Pos (szS firstSize)
  | posNext (nextSize : Size) (nextPos : Pos nextSize) : Pos (szS nextSize)
-- The words of adjacent swaps (S7 B3, Q5): wordSwap applies the rest,
-- then swaps the first two positions, and wordLift applies the inner
-- word to the tail, then the rest. The orbits of a word action are the
-- orbits of the symmetric group.
family Word : Size -> Type 0 := wordNil (nilSize : Size) : Word nilSize
  | wordSwap (wordAt : Size) (wordRest : Word (szS (szS wordAt))) : Word (szS (szS wordAt))
  | wordLift (liftSize : Size) (liftInner : Word liftSize) (liftRest : Word (szS liftSize)) : Word (szS liftSize)
-- The choice bags and the orbits at each size (S3, design C section 3,
-- USER ruling Q-S3-6 (a)). ChoiceBag is the old cons Bag at the choice
-- type Sum Unit Unit, and OrbitN n is the quotient of the configurations
-- Pos n -> Sum Unit Unit by the word action. The two families have no
-- parameter, so they are not type constructors (rule R1). sizePred gives
-- the index of a tail, consP puts a choice in front of a configuration,
-- swapFront swaps the first two positions and actW is the word action.
def sizePred : Size -> Size := fun (s : Size) => elim (fun (t : Size) => Size) sz0 (fun (k : Size) (ih : Size) => k) s
def consP : (n : Size) -> Sum Unit Unit -> (Pos n -> Sum Unit Unit) -> Pos (szS n) -> Sum Unit Unit :=
  fun (n : Size) (a : Sum Unit Unit) (t : Pos n -> Sum Unit Unit) (p : Pos (szS n)) =>
    (elim (fun (k : Size) (q : Pos k) => Sum Unit Unit -> (Pos (sizePred k) -> Sum Unit Unit) -> Sum Unit Unit)
      (fun (m : Size) => fun (b : Sum Unit Unit) (u : Pos m -> Sum Unit Unit) => b)
      (fun (m : Size) (q : Pos m) (ih : Sum Unit Unit -> (Pos (sizePred m) -> Sum Unit Unit) -> Sum Unit Unit) => fun (b : Sum Unit Unit) (u : Pos m -> Sum Unit Unit) => u q) p) a t
def swapFront : (m : Size) -> (Pos (szS (szS m)) -> Sum Unit Unit) -> Pos (szS (szS m)) -> Sum Unit Unit :=
  fun (m : Size) (c : Pos (szS (szS m)) -> Sum Unit Unit) =>
    consP (szS m) (c (posNext (szS m) (posFirst m))) (consP m (c (posFirst (szS m))) (fun (p : Pos m) => c (posNext (szS m) (posNext m p))))
def actW : (n : Size) -> Word n -> (Pos n -> Sum Unit Unit) -> Pos n -> Sum Unit Unit :=
  fun (n : Size) (w : Word n) => elim (fun (k : Size) (v : Word k) => (Pos k -> Sum Unit Unit) -> Pos k -> Sum Unit Unit)
    (fun (k : Size) => fun (d : Pos k -> Sum Unit Unit) => d)
    (fun (m : Size) (v : Word (szS (szS m))) (ih : (Pos (szS (szS m)) -> Sum Unit Unit) -> Pos (szS (szS m)) -> Sum Unit Unit) =>
      fun (d : Pos (szS (szS m)) -> Sum Unit Unit) => swapFront m (ih d))
    (fun (m : Size) (u : Word m) (ihu : (Pos m -> Sum Unit Unit) -> Pos m -> Sum Unit Unit) (v : Word (szS m)) (ihv : (Pos (szS m) -> Sum Unit Unit) -> Pos (szS m) -> Sum Unit Unit) =>
      fun (d : Pos (szS m) -> Sum Unit Unit) => ihv (consP m (d (posFirst m)) (ihu (fun (p : Pos m) => d (posNext m p))))) w
family ChoiceBag : Size -> Type 0 := choiceNil : ChoiceBag sz0
  | choiceCons (cbSize : Size) (cbHead : Sum Unit Unit) (cbTail : ChoiceBag cbSize) : ChoiceBag (szS cbSize)
  | choiceSwap (cbSwapSize : Size) (cbFirst : Sum Unit Unit) (cbSecond : Sum Unit Unit) (cbSwapTail : ChoiceBag cbSwapSize) (i : I) : ChoiceBag (szS (szS cbSwapSize))
    [ ~i -> choiceCons (szS cbSwapSize) cbFirst (choiceCons cbSwapSize cbSecond cbSwapTail), i -> choiceCons (szS cbSwapSize) cbSecond (choiceCons cbSwapSize cbFirst cbSwapTail) ]
  | choiceSquash (cbSquashSize : Size) (cbFrom : ChoiceBag cbSquashSize) (cbTo : ChoiceBag cbSquashSize) (cbLeft : Path (ChoiceBag cbSquashSize) cbFrom cbTo) (cbRight : Path (ChoiceBag cbSquashSize) cbFrom cbTo) (i : I) (j : I) : ChoiceBag cbSquashSize
    [ ~i -> cbLeft @ j, i -> cbRight @ j, ~j -> cbFrom, j -> cbTo ]
family OrbitN : Size -> Type 0 := orbitNOf (onSize : Size) (onOf : Pos onSize -> Sum Unit Unit) : OrbitN onSize
  | orbitNEq (onEqSize : Size) (onA : Pos onEqSize -> Sum Unit Unit) (onB : Pos onEqSize -> Sum Unit Unit) (onR : Sigma (w : Word onEqSize) (Path (Pos onEqSize -> Sum Unit Unit) (actW onEqSize w onB) onA)) (i : I) : OrbitN onEqSize
    [ ~i -> orbitNOf onEqSize onA, i -> orbitNOf onEqSize onB ]
  | orbitNSquash (onSqSize : Size) (onFrom : OrbitN onSqSize) (onTo : OrbitN onSqSize) (onLeft : Path (OrbitN onSqSize) onFrom onTo) (onRight : Path (OrbitN onSqSize) onFrom onTo) (i : I) (j : I) : OrbitN onSqSize
    [ ~i -> onLeft @ j, i -> onRight @ j, ~j -> onFrom, j -> onTo ]
-- The charter and its ratifications (S6, O20): an inductive-inductive
-- block. Ratified c is a rule ratified at the charter c, adopt adds a
-- ratified rule to a charter, and adoptTwice is law 4 in the type: a
-- second adoption of the same rule is a path from the first. A squash at
-- each sort in the form of Trunc0 squash0 makes each sort a set. Field
-- names are global (rule R4), so each has the prefix of its constructor.
-- The rule type is Size (S3, USER ruling Q-S3-7 (a)): the block has no
-- parameter, so it is not a type constructor (rule R1).
family Charter := genesis
  | adopt (adoptBase : Charter) (adoptRule : Ratified adoptBase)
  | adoptTwice (twiceBase : Charter) (twiceRule : Size) (i : I)
    [ ~i -> adopt twiceBase (ratify twiceBase twiceRule), i -> adopt (adopt twiceBase (ratify twiceBase twiceRule)) (ratify (adopt twiceBase (ratify twiceBase twiceRule)) twiceRule) ]
  | charterSquash (charterFrom : Charter) (charterTo : Charter) (charterLeft : Path Charter charterFrom charterTo) (charterRight : Path Charter charterFrom charterTo) (i : I) (j : I)
    [ ~i -> charterLeft @ j, i -> charterRight @ j, ~j -> charterFrom, j -> charterTo ]
and Ratified : Charter -> Type 0 := ratify (ratifyBase : Charter) (ratifyRule : Size) : Ratified ratifyBase
  | ratifiedSquash (ratifiedAt : Charter) (ratifiedFrom : Ratified ratifiedAt) (ratifiedTo : Ratified ratifiedAt) (ratifiedLeft : Path (Ratified ratifiedAt) ratifiedFrom ratifiedTo) (ratifiedRight : Path (Ratified ratifiedAt) ratifiedFrom ratifiedTo) (i : I) (j : I) : Ratified ratifiedAt
    [ ~i -> ratifiedLeft @ j, i -> ratifiedRight @ j, ~j -> ratifiedFrom, j -> ratifiedTo ]

-- Equivalences (S3a, R3 (a)): contractible types, fibers, isEquiv and
-- Equiv as Sigma types (the map, then for each y the center pack x p and
-- the contraction), idEquiv, and isoToEquiv as in agda/cubical
-- isoToIsEquiv. isoCap is the fill at k = i1; isoPath is the first part
-- of the fiber path. The squares are inline, with j flipped.
def isContr : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => Sigma (c : A) ((x : A) -> Path A c x)
def fiber : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (y : B) -> Type 0 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (y : B) => Sigma (x : A) (Path B (f x) y)
def isEquiv : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> Type 0 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => (y : B) -> isContr (fiber A B f y)
def Equiv : (A : Type 0) -> (B : Type 0) -> Type 0 :=
  fun (A : Type 0) => fun (B : Type 0) => Sigma (f : A -> B) (isEquiv A B f)
def idEquiv : (A : Type 0) -> Equiv A A :=
  fun (A : Type 0) => pack (fun (x : A) => x) (fun (y : A) =>
    pack (pack y refl) (fun (z : fiber A A (fun (x : A) => x) y) =>
      fun (i : I) => pack (payload z @ ~i) (fun (j : I) => payload z @ (~i \/ j))))
def isoCap : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (t : (x : A) -> Path A (g (f x)) x) ->
  (y : B) -> (x0 : A) -> (p0 : Path B (f x0) y) -> Path A (g y) x0 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (g : B -> A) => fun (t : (x : A) -> Path A (g (f x)) x) =>
  fun (y : B) => fun (x0 : A) => fun (p0 : Path B (f x0) y) =>
    fun (i : I) => hcomp A (i \/ ~i \/ ~i1) (fun (m : I) => [ i -> t x0 @ (i1 /\ m), ~i -> g y, ~i1 -> g (p0 @ ~i) ]) (g (p0 @ ~i))
def isoPath : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (t : (x : A) -> Path A (g (f x)) x) ->
  (y : B) -> (x0 : A) -> (p0 : Path B (f x0) y) -> (x1 : A) -> (p1 : Path B (f x1) y) -> Path A x0 x1 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (g : B -> A) => fun (t : (x : A) -> Path A (g (f x)) x) =>
  fun (y : B) => fun (x0 : A) => fun (p0 : Path B (f x0) y) => fun (x1 : A) => fun (p1 : Path B (f x1) y) =>
    fun (i : I) => hcomp A (i \/ ~i \/ ~i1) (fun (m2 : I) => [ i -> isoCap A B f g t y x1 p1 @ (i1 /\ m2), ~i -> isoCap A B f g t y x0 p0 @ (i1 /\ m2), ~i1 -> g y ]) (g y)
def isoToEquiv : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) ->
  (s : (y : B) -> Path B (f (g y)) y) -> (t : (x : A) -> Path A (g (f x)) x) -> Equiv A B :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (g : B -> A) =>
  fun (s : (y : B) -> Path B (f (g y)) y) => fun (t : (x : A) -> Path A (g (f x)) x) =>
  pack f (fun (y : B) => pack (pack (g y) (s y)) (fun (z : fiber A B f y) =>
    fun (i : I) => pack (isoPath A B f g t y (g y) (s y) (witness z) (payload z) @ i) (fun (j : I) =>
      hcomp B (i \/ ~i \/ ~j \/ j) (fun (m4 : I) => [
        i -> s (payload z @ j) @ m4,
        ~i -> s (s y @ j) @ m4,
        ~j -> s (f (isoPath A B f g t y (g y) (s y) (witness z) (payload z) @ i)) @ m4,
        j -> s y @ m4 ])
      (f (hcomp A (i \/ ~i \/ ~j \/ j) (fun (m3 : I) => [
        i -> hcomp A (~j \/ j \/ m3) (fun (m : I) => [ ~j -> t (witness z) @ (~m3 /\ m), j -> g y, m3 -> g (payload z @ j) ]) (g (payload z @ j)),
        ~i -> hcomp A (~j \/ j \/ m3) (fun (m : I) => [ ~j -> t (g y) @ (~m3 /\ m), j -> g y, m3 -> g (s y @ j) ]) (g (s y @ j)),
        ~j -> t (isoPath A B f g t y (g y) (s y) (witness z) (payload z) @ i) @ ~m3,
        j -> g y ])
        (hcomp A (i \/ ~i \/ j) (fun (m2 : I) => [
          i -> isoCap A B f g t y (witness z) (payload z) @ (~j /\ m2),
          ~i -> isoCap A B f g t y (g y) (s y) @ (~j /\ m2),
          j -> g y ]) (g y)))))))

-- ua (S3b): the Glue line from A to B. At i0 the type is A through e; at
-- i1 the type is B through idEquiv B. Transport along ua e at a closed
-- value of A gives witness e of the value (uaBeta).
def ua : (A : Type 0) -> (B : Type 0) -> (e : Equiv A B) -> Path (Type 0) A B :=
  fun (A : Type 0) => fun (B : Type 0) => fun (e : Equiv A B) =>
    fun (i : I) => Glue B (~i \/ i) (fun (_ : I) => [ ~i -> pack A e, i -> pack B (idEquiv B) ])
-- uaArrow (S3c): agda/cubical ua-> with a constant C. A path h a from
-- f0 a to f1 (witness e a) for each a gives a path of functions over ua e
-- from f0 to f1. At i0 the hcomp is its ~i tube at j = i1, h a @ i0 =
-- f0 a; at i1 it is its i tube, f1 a. The base is f1 (unglue a).
def uaArrow : (A : Type 0) -> (B : Type 0) -> (C : Type 0) -> (e : Equiv A B) -> (f0 : A -> C) -> (f1 : B -> C) ->
  (h : (a : A) -> Path C (f0 a) (f1 (witness e a))) -> PathP (fun (i : I) => (ua A B e @ i) -> C) f0 f1 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (C : Type 0) => fun (e : Equiv A B) => fun (f0 : A -> C) => fun (f1 : B -> C) =>
  fun (h : (a : A) -> Path C (f0 a) (f1 (witness e a))) =>
    fun (i : I) => fun (a : ua A B e @ i) => hcomp C (~i \/ i) (fun (j : I) => [ ~i -> h a @ ~j, i -> f1 a ]) (f1 (unglue a))

-- A binary tree for the IR tests (S3). fork has
-- two recursive fields, so a fold over a run-time Tree gives
-- REFUSE_RUNTIME_TREE (test/ir/tree.lang). No def here uses it.
family Tree := tip | fork (forkLeft : Tree) (forkRight : Tree)

-- Two blocks for the block rows of the lowering (S3). Signal and Window have no recursive field, so a fold over
-- Window is a case split: its cases come after the two cases of Signal
-- (test/ir/block.lang). Hop and Echo each have one recursive field of the
-- other family, so the lowering refuses a fold over them (test/ir/hop.lang).
family Signal := sigQuiet | sigLoud (loudLevel : Nat)
and Window := winOpen | winShut (shutFor : Nat)
family Hop := hopEnd | hopNext (nextEcho : Echo)
and Echo := echoBack (backHop : Hop)
-- The committee (S4, design section 4, USER ruling Q-S4-1 (a)): the sizes
-- of the classes 1 to k. Parties in one class are interchangeable. A field
-- name is a core name (rule R4), so the fields have the prefixes cm, pt,
-- ap and ct.
family Committee := cmNil | cmClass (cmSize : Size) (cmRest : Committee)
-- A party: a position in the first class, or a party of the rest.
family Party : Committee -> Type 0 := ptHere (ptSize : Size) (ptRest : Committee) (ptAt : Pos ptSize) : Party (cmClass ptSize ptRest)
  | ptThere (ptOfSize : Size) (ptOfRest : Committee) (ptOf : Party ptOfRest) : Party (cmClass ptOfSize ptOfRest)
-- An approval set: a bit map for each class. inr unit is an approval and
-- inl unit is no approval (a missing ballot counts as no approval). A
-- guest program reads an approval set only through count (REFUSE_ORBIT,
-- Q-S4-2 (a)).
family Approvals : Committee -> Type 0 := apNil : Approvals cmNil
  | apClass (apSize : Size) (apRest : Committee) (apBits : Pos apSize -> Sum Unit Unit) (apTail : Approvals apRest) : Approvals (cmClass apSize apRest)
-- A count vector: Pos (szS n) has n + 1 values, so 0 <= c_j <= n_j holds
-- by type, and the count space has the product of the n_j + 1 values.
family Counts : Committee -> Type 0 := ctNil : Counts cmNil
  | ctClass (ctSize : Size) (ctRest : Committee) (ctValue : Pos (szS ctSize)) (ctTail : Counts ctRest) : Counts (cmClass ctSize ctRest)
-- posWeaken keeps the value of a position. countBits counts the approvals
-- of a bit map: an approval at the head gives posNext, no approval gives
-- posWeaken.
def posWeaken : (n : Size) -> Pos n -> Pos (szS n) :=
  fun (n : Size) (p : Pos n) => elim (fun (k : Size) (q : Pos k) => Pos (szS k))
    (fun (m : Size) => posFirst (szS m))
    (fun (m : Size) (q : Pos m) (ih : Pos (szS m)) => posNext (szS m) ih) p
def countBits : (n : Size) -> (Pos n -> Sum Unit Unit) -> Pos (szS n) :=
  fun (n : Size) => elim (fun (k : Size) => (Pos k -> Sum Unit Unit) -> Pos (szS k))
    (fun (b : Pos sz0 -> Sum Unit Unit) => posFirst sz0)
    (fun (m : Size) (ih : (Pos m -> Sum Unit Unit) -> Pos (szS m)) => fun (b : Pos (szS m) -> Sum Unit Unit) =>
      either (fun (u : Unit) => posWeaken (szS m) (ih (fun (p : Pos m) => b (posNext m p))))
        (fun (u : Unit) => posNext (szS m) (ih (fun (p : Pos m) => b (posNext m p)))) (b (posFirst m))) n
-- count P S = (|S intersect class_j|) for j = 1 .. k (design section 5).
def count : (c : Committee) -> Approvals c -> Counts c :=
  fun (c : Committee) (S : Approvals c) => elim (fun (k : Committee) (T : Approvals k) => Counts k) ctNil
    (fun (n : Size) (r : Committee) (b : Pos n -> Sum Unit Unit) (t : Approvals r) (ih : Counts r) => ctClass n r (countBits n b) ih) S
-- G_P (design section 4): the permutations that map each class to itself,
-- one word of adjacent swaps for each class (a large elim on Committee).
-- A Perm has no word across two classes. actP applies actW to each class,
-- so count c (actP c w S) = count c S (TCM-A).
def Perm : Committee -> Type 0 :=
  fun (c : Committee) => elim (fun (k : Committee) => Type 0) Unit (fun (n : Size) (r : Committee) (h : Type 0) => Prod (Word n) h) c
def actP : (c : Committee) -> Perm c -> Approvals c -> Approvals c :=
  fun (c : Committee) (w : Perm c) (S : Approvals c) => elim (fun (k : Committee) (T : Approvals k) => Perm k -> Approvals k)
    (fun (u : Perm cmNil) => apNil)
    (fun (n : Size) (r : Committee) (b : Pos n -> Sum Unit Unit) (t : Approvals r) (ih : Perm r -> Approvals r) =>
      fun (v : Perm (cmClass n r)) => apClass n r (actW n (first v) b) (ih (second v))) S w
-- The rule words (S5, PLAN sections 4.1 and 4.2, USER rulings Q-S5-1 (a)
-- and Q-S5-2 (a)). sAnd and sOr are and and or on Sum Unit Unit (inr unit
-- is true). posVal gives the value of a position as a Size. szLe and szEq
-- compare two sizes.
def sAnd : Sum Unit Unit -> Sum Unit Unit -> Sum Unit Unit :=
  fun (x : Sum Unit Unit) (y : Sum Unit Unit) => either (fun (u : Unit) => inl unit) (fun (u : Unit) => y) x
def sOr : Sum Unit Unit -> Sum Unit Unit -> Sum Unit Unit :=
  fun (x : Sum Unit Unit) (y : Sum Unit Unit) => either (fun (u : Unit) => y) (fun (u : Unit) => inr unit) x
def posVal : (n : Size) -> Pos n -> Size :=
  fun (n : Size) (p : Pos n) => elim (fun (k : Size) (q : Pos k) => Size)
    (fun (m : Size) => sz0)
    (fun (m : Size) (q : Pos m) (ih : Size) => szS ih) p
def szLe : Size -> Size -> Sum Unit Unit :=
  fun (a : Size) => elim (fun (k : Size) => Size -> Sum Unit Unit)
    (fun (b : Size) => inr unit)
    (fun (m : Size) (ih : Size -> Sum Unit Unit) => fun (b : Size) => elim (fun (k : Size) => Sum Unit Unit) (inl unit)
      (fun (j : Size) (h : Sum Unit Unit) => ih j) b) a
def szEq : Size -> Size -> Sum Unit Unit :=
  fun (a : Size) => elim (fun (k : Size) => Size -> Sum Unit Unit)
    (fun (b : Size) => elim (fun (k : Size) => Sum Unit Unit) (inr unit) (fun (j : Size) (h : Sum Unit Unit) => inl unit) b)
    (fun (m : Size) (ih : Size -> Sum Unit Unit) => fun (b : Size) => elim (fun (k : Size) => Sum Unit Unit) (inl unit)
      (fun (j : Size) (h : Sum Unit Unit) => ih j) b) a
-- ctAll q c a b is q a_j b_j at each class j (sAnd of the results). CtK k
-- is the type of the inner elim on b: the tail test and the value a_j.
def CtK : Committee -> Type 0 :=
  fun (c : Committee) => elim (fun (k : Committee) => Type 0) (Sum Unit Unit)
    (fun (n : Size) (r : Committee) (h : Type 0) => (Counts r -> Sum Unit Unit) -> Size -> Sum Unit Unit) c
def ctAll : (Size -> Size -> Sum Unit Unit) -> (c : Committee) -> Counts c -> Counts c -> Sum Unit Unit :=
  fun (q : Size -> Size -> Sum Unit Unit) (c : Committee) (a : Counts c) => elim (fun (k : Committee) (v : Counts k) => Counts k -> Sum Unit Unit)
    (fun (w : Counts cmNil) => inr unit)
    (fun (n : Size) (r : Committee) (x : Pos (szS n)) (t : Counts r) (ih : Counts r -> Sum Unit Unit) => fun (w : Counts (cmClass n r)) =>
      elim (fun (k : Committee) (v : Counts k) => CtK k) (inl unit)
        (fun (n2 : Size) (r2 : Committee) (y : Pos (szS n2)) (t2 : Counts r2) (h2 : CtK r2) =>
          fun (g : Counts r2 -> Sum Unit Unit) (z : Size) => sAnd (q z (posVal (szS n2) y)) (g t2)) w ih (posVal (szS n) x)) a
-- A table of count vectors. tbHas c t v is inr unit when v is a row of t.
family CtTable : Committee -> Type 0 := tbNil (tbNilOf : Committee) : CtTable tbNilOf
  | tbCons (tbOf : Committee) (tbRow : Counts tbOf) (tbRest : CtTable tbOf) : CtTable tbOf
def tbHas : (c : Committee) -> CtTable c -> Counts c -> Sum Unit Unit :=
  fun (c : Committee) (t : CtTable c) => elim (fun (k : Committee) (s : CtTable k) => Counts k -> Sum Unit Unit)
    (fun (k : Committee) => fun (w : Counts k) => inl unit)
    (fun (k : Committee) (row : Counts k) (s : CtTable k) (ih : Counts k -> Sum Unit Unit) => fun (w : Counts k) => sOr (ctAll szEq k row w) (ih w)) t
-- A rule (design section 4.2): rlMin accepts a count vector at or above the
-- bar at each class, rlAnd and rlOr are pointwise, and rlTable accepts
-- exactly the listed vectors. The checker decides O3 on each closed rule
-- (REFUSE_RULE).
family Rule : Committee -> Type 0 := rlMin (rlMinOf : Committee) (rlBar : Counts rlMinOf) : Rule rlMinOf
  | rlAnd (rlAndOf : Committee) (rlAndL : Rule rlAndOf) (rlAndR : Rule rlAndOf) : Rule rlAndOf
  | rlOr (rlOrOf : Committee) (rlOrL : Rule rlOrOf) (rlOrR : Rule rlOrOf) : Rule rlOrOf
  | rlTable (rlTableOf : Committee) (rlRows : CtTable rlTableOf) : Rule rlTableOf
def accept : (c : Committee) -> Rule c -> Counts c -> Sum Unit Unit :=
  fun (c : Committee) (r : Rule c) => elim (fun (k : Committee) (q : Rule k) => Counts k -> Sum Unit Unit)
    (fun (k : Committee) (b : Counts k) => fun (w : Counts k) => ctAll szLe k b w)
    (fun (k : Committee) (x : Rule k) (hx : Counts k -> Sum Unit Unit) (y : Rule k) (hy : Counts k -> Sum Unit Unit) => fun (w : Counts k) => sAnd (hx w) (hy w))
    (fun (k : Committee) (x : Rule k) (hx : Counts k -> Sum Unit Unit) (y : Rule k) (hy : Counts k -> Sum Unit Unit) => fun (w : Counts k) => sOr (hx w) (hy w))
    (fun (k : Committee) (t : CtTable k) => fun (w : Counts k) => tbHas k t w) r
-- Honest c f: a rule that the checker decides at a closed c and f by O3
-- and O4 (REFUSE_HONEST). ForkFree c f: O3, O4 and O5 (REFUSE_FORK).
family Honest : Committee -> Size -> Type 0 := hoRule (hoOf : Committee) (hoF : Size) (hoBody : Rule hoOf) : Honest hoOf hoF
family ForkFree : Committee -> Size -> Type 0 := ffRule (ffOf : Committee) (ffF : Size) (ffBody : Rule ffOf) : ForkFree ffOf ffF
-- The policy words (S6, Q-S6-1 (a)): a policy has a committee, a fault bound
-- f, an authorize rule (Honest: O3 and O4) and an amend rule (ForkFree: O3,
-- O4 and O5). A Decision is binary (O2): inr unit accepts, inl unit refuses.
def Decision : Type 0 := Sum Unit Unit
family Policy := plOf (plCom : Committee) (plF : Size) (plAuth : Honest plCom plF) (plAmend : ForkFree plCom plF)
def polCom : Policy -> Committee :=
  fun (p : Policy) => elim (fun (q : Policy) => Committee) (fun (c : Committee) (f : Size) (h : Honest c f) (a : ForkFree c f) => c) p
def hoBodyOf : (c : Committee) -> (f : Size) -> Honest c f -> Rule c :=
  fun (c : Committee) (f : Size) (h : Honest c f) => elim (fun (k : Committee) (g : Size) (q : Honest k g) => Rule k) (fun (k : Committee) (g : Size) (b : Rule k) => b) h
def ffBodyOf : (c : Committee) -> (f : Size) -> ForkFree c f -> Rule c :=
  fun (c : Committee) (f : Size) (h : ForkFree c f) => elim (fun (k : Committee) (g : Size) (q : ForkFree k g) => Rule k) (fun (k : Committee) (g : Size) (b : Rule k) => b) h
-- authorize P a S = accept of the authorize rule at count S; a is not read.
def authorize : (P : Policy) -> (A : Type 0) -> A -> Approvals (polCom P) -> Decision :=
  fun (P : Policy) (A : Type 0) (a : A) => elim (fun (q : Policy) => Approvals (polCom q) -> Decision)
    (fun (c : Committee) (f : Size) (h : Honest c f) (r : ForkFree c f) => fun (s : Approvals c) => accept c (hoBodyOf c f h) (count c s)) P
def amendOk : (P : Policy) -> Approvals (polCom P) -> Decision :=
  fun (P : Policy) => elim (fun (q : Policy) => Approvals (polCom q) -> Decision)
    (fun (c : Committee) (f : Size) (h : Honest c f) (r : ForkFree c f) => fun (s : Approvals c) => accept c (ffBodyOf c f r) (count c s)) P
-- An amendment from P to Q: an approval set that the amend rule of P accepts.
family Amendment : Policy -> Policy -> Type 0 := amOf (amFrom : Policy) (amTo : Policy) (amSet : Approvals (polCom amFrom)) (amOk : Path Decision (amendOk amFrom amSet) (inr unit)) : Amendment amFrom amTo
-- The log (CM): the free category on the amendments, nil, cons and append.
family Log : Policy -> Policy -> Type 0 := lgNil (lgNilOf : Policy) : Log lgNilOf lgNilOf
  | lgCons (lgFrom : Policy) (lgMid : Policy) (lgTo : Policy) (lgHead : Amendment lgFrom lgMid) (lgTail : Log lgMid lgTo) : Log lgFrom lgTo
def append : (P : Policy) -> (Q : Policy) -> (R : Policy) -> Log P Q -> Log Q R -> Log P R :=
  fun (P : Policy) (Q : Policy) (R : Policy) (l : Log P Q) => elim (fun (p : Policy) (q : Policy) (k : Log p q) => Log q R -> Log p R)
    (fun (n : Policy) => fun (m : Log n R) => m)
    (fun (x : Policy) (y : Policy) (z : Policy) (hd : Amendment x y) (tl : Log y z) (ih : Log z R -> Log y R) => fun (m : Log z R) => lgCons x y R hd (ih m)) l
-- TCM-E: nil is a unit and append is associative (paths by induction).
def appendNilL : (P : Policy) -> (Q : Policy) -> (l : Log P Q) -> Path (Log P Q) (append P P Q (lgNil P) l) l :=
  fun (P : Policy) (Q : Policy) (l : Log P Q) => fun (i : I) => l
def appendNilR : (P : Policy) -> (Q : Policy) -> (l : Log P Q) -> Path (Log P Q) (append P Q Q l (lgNil Q)) l :=
  fun (P : Policy) (Q : Policy) (l : Log P Q) => elim (fun (p : Policy) (q : Policy) (k : Log p q) => Path (Log p q) (append p q q k (lgNil q)) k)
    (fun (n : Policy) => fun (i : I) => lgNil n)
    (fun (x : Policy) (y : Policy) (z : Policy) (hd : Amendment x y) (tl : Log y z) (ih : Path (Log y z) (append y z z tl (lgNil z)) tl) => fun (i : I) => lgCons x y z hd (ih @ i)) l
def appendAssoc : (P : Policy) -> (Q : Policy) -> (R : Policy) -> (S : Policy) -> (a : Log P Q) -> (b : Log Q R) -> (c : Log R S) -> Path (Log P S) (append P Q S a (append Q R S b c)) (append P R S (append P Q R a b) c) :=
  fun (P : Policy) (Q : Policy) (R : Policy) (S : Policy) (a : Log P Q) => elim (fun (p : Policy) (q : Policy) (k : Log p q) => (b : Log q R) -> (c : Log R S) -> Path (Log p S) (append p q S k (append q R S b c)) (append p R S (append p q R k b) c))
    (fun (n : Policy) => fun (b : Log n R) (c : Log R S) => fun (i : I) => append n R S b c)
    (fun (x : Policy) (y : Policy) (z : Policy) (hd : Amendment x y) (tl : Log y z) (ih : (b : Log z R) -> (c : Log R S) -> Path (Log y S) (append y z S tl (append z R S b c)) (append y R S (append y z R tl b) c)) => fun (b : Log z R) (c : Log R S) => fun (i : I) => lgCons x y S hd ((ih b c) @ i)) a
def lgLen : (P : Policy) -> (Q : Policy) -> Log P Q -> Size :=
  fun (P : Policy) (Q : Policy) (l : Log P Q) => elim (fun (p : Policy) (q : Policy) (k : Log p q) => Size)
    (fun (n : Policy) => sz0)
    (fun (x : Policy) (y : Policy) (z : Policy) (hd : Amendment x y) (tl : Log y z) (ih : Size) => szS ih) l
-- policyAt (O10): the first policy at height 0, the policy of the tail at
-- height h + 1, and the last policy past the end.
def policyAtSize : (P : Policy) -> (Q : Policy) -> Log P Q -> Size -> Policy :=
  fun (P : Policy) (Q : Policy) (l : Log P Q) => elim (fun (p : Policy) (q : Policy) (k : Log p q) => Size -> Policy)
    (fun (n : Policy) => fun (h : Size) => n)
    (fun (x : Policy) (y : Policy) (z : Policy) (hd : Amendment x y) (tl : Log y z) (ih : Size -> Policy) => fun (h : Size) => elim (fun (k : Size) => Policy) x (fun (k : Size) (r : Policy) => ih k) h) l
def policyAt : (P : Policy) -> (Q : Policy) -> (l : Log P Q) -> Pos (szS (lgLen P Q l)) -> Policy :=
  fun (P : Policy) (Q : Policy) (l : Log P Q) (h : Pos (szS (lgLen P Q l))) => policyAtSize P Q l (posVal (szS (lgLen P Q l)) h)
-- The system (CC, Q-S6-4 (a)): the stream of the policies, one per height.
def System : Type 0 := Stream Policy
def systemOf : (P : Policy) -> (Q : Policy) -> Log P Q -> System :=
  fun (P : Policy) (Q : Policy) (l : Log P Q) => sCorec Policy Size (policyAtSize P Q l) (fun (h : Size) => szS h) sz0
-- S7 (Q-S7-1 (a)): the code sort of the crypto words and its decoder El.
family Base := baseBool | baseCounts (baseCom : Committee)
def El : Base -> Type 0 :=
  fun (b : Base) => elim (fun (k : Base) => Type 0) (Sum Unit Unit) (fun (c : Committee) => Counts c) b
family Enc : Base -> Type 0 := encOf (encBase : Base) (encVal : El encBase) : Enc encBase
-- The crypto words (S7, PLAN sections 4.1 and 4.2). The denotation of each word is the
-- value, so eval needs no crypto. The real scheme is in src/crypto (build/cryptotool).
-- enc pk a = a. The key pk is a number; the denotation does not read it.
def enc : (b : Base) -> Nat -> El b -> Enc b :=
  fun (b : Base) (pk : Nat) (a : El b) => encOf b a
def encMeaning : (b : Base) -> Enc b -> El b :=
  fun (b : Base) (c : Enc b) => elim (fun (k : Base) (e : Enc k) => El k) (fun (k : Base) (v : El k) => v) c
-- eval g c_1 c_2 = g of the meanings (the homomorphic step, two inputs).
def eval : (a : Base) -> (b : Base) -> (c : Base) -> (El a -> El b -> El c) -> Enc a -> Enc b -> Enc c :=
  fun (a : Base) (b : Base) (c : Base) (g : El a -> El b -> El c) (x : Enc a) (y : Enc b) => encOf c (g (encMeaning a x) (encMeaning b y))
-- Share a: the shares of a secret. share t n s = s; reshare keeps the secret and
-- changes the holders; reconstruct T xs = s, total (Q-S0-2 (a)).
family Share : Base -> Type 0 := shareOf (shareBase : Base) (shareVal : El shareBase) : Share shareBase
def share : (b : Base) -> Size -> Size -> El b -> Share b :=
  fun (b : Base) (t : Size) (n : Size) (s : El b) => shareOf b s
def reconstruct : (b : Base) -> Size -> Share b -> El b :=
  fun (b : Base) (t : Size) (xs : Share b) => elim (fun (k : Base) (e : Share k) => El k) (fun (k : Base) (v : El k) => v) xs
def reshare : (b : Base) -> Committee -> Committee -> Size -> Share b -> Share b :=
  fun (b : Base) (old : Committee) (new : Committee) (t : Size) (xs : Share b) => shareOf b (reconstruct b t xs)
-- Proof R x: a witness exists, and the proof does not show it (Trunc1).
def Proof : (X : Type 0) -> (W : Type 0) -> (X -> W -> Type 0) -> X -> Type 0 :=
  fun (X : Type 0) (W : Type 0) (R : X -> W -> Type 0) (x : X) => Trunc1 (Sigma (w : W) (R x w))
def prove : (X : Type 0) -> (W : Type 0) -> (R : X -> W -> Type 0) -> (x : X) -> (w : W) -> R x w -> Proof X W R x :=
  fun (X : Type 0) (W : Type 0) (R : X -> W -> Type 0) (x : X) (w : W) (h : R x w) => trunc1 (Sigma (w : W) (R x w)) (pack w h)
-- Protocol a b: the ideal function of a protocol, run pi xs = f_pi(xs). A family with a
-- function field is not a cell signature (R1), so Protocol is the function type. The
-- word is protoOf, not ptOf: ptOf is a field of Party (S4).
def Protocol : Type 0 -> Type 0 -> Type 0 :=
  fun (A : Type 0) (B : Type 0) => A -> B
def protoOf : (A : Type 0) -> (B : Type 0) -> (A -> B) -> Protocol A B :=
  fun (A : Type 0) (B : Type 0) (f : A -> B) => f
def run : (A : Type 0) -> (B : Type 0) -> Protocol A B -> A -> B :=
  fun (A : Type 0) (B : Type 0) (proto : Protocol A B) (xs : A) => proto xs
-- S8 (PLAN sections 2 and 4.2): the verdict of a certificate. A Reason is the
-- first check that fails (Q-S8-3 (a)): the bytes, then the link, then the
-- crypto, then the rule.
family Reason := malformed | illTypedPolicy | wrongHeight | badPrevHash | badSignature | badProof | notAccepted | equivocation
family Verdict := valid | invalid (vdReason : Reason)
-- sNot is not on Sum Unit Unit. vdThen d r v is v when d holds, else invalid r.
def sNot : Sum Unit Unit -> Sum Unit Unit :=
  fun (x : Sum Unit Unit) => either (fun (u : Unit) => inr unit) (fun (u : Unit) => inl unit) x
def vdThen : Decision -> Reason -> Verdict -> Verdict :=
  fun (d : Decision) (r : Reason) (v : Verdict) => either (fun (u : Unit) => invalid r) (fun (u : Unit) => v) d
-- apHas c S p: the approval bit of the party p in S (inr unit: p approves). ApK k
-- is the type of the inner elim on the party: the head bits and the tail test.
def ApK : Committee -> Type 0 :=
  fun (c : Committee) => elim (fun (k : Committee) => Type 0) Unit
    (fun (n : Size) (r : Committee) (h : Type 0) => (Pos n -> Sum Unit Unit) -> (Party r -> Decision) -> Decision) c
def apHas : (c : Committee) -> Approvals c -> Party c -> Decision :=
  fun (c : Committee) (S : Approvals c) => elim (fun (k : Committee) (T : Approvals k) => Party k -> Decision)
    (fun (p : Party cmNil) => inl unit)
    (fun (n : Size) (r : Committee) (b : Pos n -> Sum Unit Unit) (t : Approvals r) (ih : Party r -> Decision) => fun (p : Party (cmClass n r)) =>
      elim (fun (k : Committee) (q : Party k) => ApK k)
        (fun (n2 : Size) (r2 : Committee) (x : Pos n2) => fun (b2 : Pos n2 -> Sum Unit Unit) (g : Party r2 -> Decision) => b2 x)
        (fun (n2 : Size) (r2 : Committee) (q : Party r2) (h2 : ApK r2) => fun (b2 : Pos n2 -> Sum Unit Unit) (g : Party r2 -> Decision) => g q) p b ih) S
-- Equivocation evidence (Q-S8-4 (a), design html:532): two entries at one height,
-- signed by one party. The guest has no hash type, so a hash is a Size stand-in
-- (szEq); the C rows (test/cryptotool.c cert) carry the keccak-256 bytes.
-- equivocates: both signatures check and the two hashes differ.
family Evidence : Committee -> Type 0 := evOf (evCom : Committee) (evParty : Party evCom) (evHeight : Size) (evHashA : Size) (evHashB : Size) (evSigA : Decision) (evSigB : Decision) : Evidence evCom
family EvList : Committee -> Type 0 := evNil (evNilOf : Committee) : EvList evNilOf
  | evCons (evConsOf : Committee) (evHead : Evidence evConsOf) (evTail : EvList evConsOf) : EvList evConsOf
def equivocates : (c : Committee) -> Evidence c -> Decision :=
  fun (c : Committee) (e : Evidence c) => elim (fun (k : Committee) (v : Evidence k) => Decision)
    (fun (k : Committee) (p : Party k) (g : Size) (x : Size) (y : Size) (sa : Decision) (sb : Decision) => sAnd sa (sAnd sb (sNot (szEq x y)))) e
-- evHits c S h e: e is evidence against a party of S at the height h.
-- evAny: some evidence of the list hits.
def evHits : (c : Committee) -> Approvals c -> Size -> Evidence c -> Decision :=
  fun (c : Committee) (S : Approvals c) (h : Size) (e : Evidence c) => sAnd (equivocates c e)
    (elim (fun (k : Committee) (v : Evidence k) => Approvals k -> Decision)
      (fun (k : Committee) (p : Party k) (g : Size) (x : Size) (y : Size) (sa : Decision) (sb : Decision) => fun (T : Approvals k) => sAnd (szEq g h) (apHas k T p)) e S)
def evAny : (c : Committee) -> Approvals c -> Size -> EvList c -> Decision :=
  fun (c : Committee) (S : Approvals c) (h : Size) (l : EvList c) => elim (fun (k : Committee) (m : EvList k) => Approvals k -> Decision)
    (fun (k : Committee) => fun (T : Approvals k) => inl unit)
    (fun (k : Committee) (e : Evidence k) (t : EvList k) (ih : Approvals k -> Decision) => fun (T : Approvals k) => sOr (evHits k T h e) (ih T)) l S
-- Certificate P (Q-S8-1 (a), the checked form): the height, the action (a Size
-- code; authorize does not read it), the signer set, b (inr unit: an amendment),
-- the target P' (inr for an amendment) and one Decision for each byte check of
-- the host: well formed, well typed P', prev hash, signatures, proofs. At T1
-- (S9) the crypto imports fill the flags from the bytes.
family Certificate : Policy -> Type 0 := certOf (certPol : Policy) (certHeight : Size) (certAct : Size) (certSet : Approvals (polCom certPol)) (certAmend : Decision) (certTo : Sum Unit Policy) (certWf : Decision) (certWt : Decision) (certPrev : Decision) (certSig : Decision) (certProof : Decision) : Certificate certPol
-- verify P Q l c evs (Q-S8-2 (a)): the first failure gives the reason (Q-S8-3
-- (a)). The height of c must be lgLen l, the latest verified height (OI-2). The
-- rule of Q is the amend rule when b, else the authorize rule. A signer of c
-- with evidence at the height of c gives equivocation (Q-S8-4 (a)).
def verify : (P : Policy) -> (Q : Policy) -> Log P Q -> Certificate Q -> EvList (polCom Q) -> Verdict :=
  fun (P : Policy) (Q : Policy) (l : Log P Q) (c : Certificate Q) => elim (fun (q : Policy) (d : Certificate q) => EvList (polCom q) -> Verdict)
    (fun (q : Policy) (h : Size) (a : Size) (S : Approvals (polCom q)) (b : Decision) (t : Sum Unit Policy) (wf : Decision) (wt : Decision) (pv : Decision) (sg : Decision) (pf : Decision) => fun (evs : EvList (polCom q)) =>
      vdThen wf malformed (vdThen wt illTypedPolicy (vdThen (szEq h (lgLen P Q l)) wrongHeight (vdThen pv badPrevHash (vdThen sg badSignature (vdThen pf badProof
        (vdThen (either (fun (u : Unit) => authorize q Size a S) (fun (u : Unit) => amendOk q S) b) notAccepted
          (vdThen (sNot (evAny (polCom q) S h evs)) equivocation valid)))))))) c
