-- S9 step d1b: closed host import calls for `langc --kit eval NAME ARGS
-- --host FILE` (test/gate.sh host_eval). Each Bytes operand is a pair OFF
-- LEN. A Decision def is not an entry, so it takes no arguments and its call
-- is closed on literals; joinShares is a Nat entry on eval arguments.
def sigYes : Sum Unit Unit := sig_verify (pair 1 2) (pair 3 4) (pair 5 6)
def sigNo : Sum Unit Unit := sig_verify (pair 1 2) (pair 3 4) (pair 5 7)
def sigMiss : Sum Unit Unit := sig_verify (pair 9 9) (pair 9 9) (pair 9 9)
def hashMiss : Sum Unit Unit := hash_eq (pair 1 2) (pair 1 2)
def joinShares : Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat :=
  fun (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) (f : Nat) (g : Nat) (h : Nat) => combine (pair a b) (pair c d) (pair e f) g h
