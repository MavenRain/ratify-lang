{"jsonrpc":"2.0","id":"a\nb","result":{}}
{"jsonrpc":"2.0","id":2,"result":{"tools":[{"name":"check","description":"Checks the ratify-lang program at path. The text is the langc check --json line.","inputSchema":{"type":"object","properties":{"path":{"type":"string"}},"required":["path"]}},{"name":"fmt","description":"Gives the canonical text of the ratify-lang program at path, as langc fmt.","inputSchema":{"type":"object","properties":{"path":{"type":"string"}},"required":["path"]}},{"name":"explain","description":"Gives the fix text of a diagnostic code, as langc explain.","inputSchema":{"type":"object","properties":{"code":{"type":"string"}},"required":["code"]}},{"name":"list-base","description":"Lists the guest builtins and the domain definitions, as langc list-base. Under langc --kit mcp it lists the kit signature.","inputSchema":{"type":"object","additionalProperties":false}},{"name":"show-law","description":"Shows each law row of docs/PLAN.md section 6, or only the row with the name row, as langc show-law.","inputSchema":{"type":"object","properties":{"row":{"type":"string"}}}},{"name":"build","description":"Builds the ratify-lang program at path and writes the file out, as langc build PATH -o OUT. The target runtime adds --runtime.","inputSchema":{"type":"object","properties":{"path":{"type":"string"},"target":{"type":"string","enum":["main","runtime"]},"out":{"type":"string"}},"required":["path","target","out"]}}]}}
