func addOr (nat, nat) -> nat, 7 locals, 2 heap words
  if add_carry(l0, l1) {
    l4 := alloc [0]
    l3 := l4
  } else {
    l5 := alloc [1, add(l0, l1)]
    l3 := l5
  }
  switch load(l3, 0) {
  arm 0:
    l2 := 0
  arm 1:
    l6 := load(l3, 1)
    l2 := l6
  }
  return l2
func divBy (nat, nat) -> nat, 8 locals, 2 heap words
  if eq(l1, 0) {
    l4 := alloc [0]
    l3 := l4
  } else {
    l5 := alloc [1, l1]
    l3 := l5
  }
  switch load(l3, 0) {
  arm 0:
    l2 := 0
  arm 1:
    l6 := load(l3, 1)
    l7 := div(l0, l6)
    l2 := l7
  }
  return l2
func modBy (nat, nat) -> nat, 8 locals, 2 heap words
  if eq(l1, 0) {
    l4 := alloc [0]
    l3 := l4
  } else {
    l5 := alloc [1, l1]
    l3 := l5
  }
  switch load(l3, 0) {
  arm 0:
    l2 := 0
  arm 1:
    l6 := load(l3, 1)
    l7 := mod(l0, l6)
    l2 := l7
  }
  return l2
func unwrap (nat) -> nat, 6 locals, 2 heap words
  if eq(l0, 0) {
    l3 := alloc [0]
    l2 := l3
  } else {
    l4 := alloc [1, l0]
    l2 := l4
  }
  switch load(l2, 0) {
  arm 0:
    l1 := 0
  arm 1:
    l5 := load(l2, 1)
    l1 := l5
  }
  return l1
func pickSecond (nat, nat) -> nat, 10 locals, 5 heap words
  if add_carry(l0, l1) {
    l5 := alloc [0]
    l4 := l5
  } else {
    l6 := alloc [1, add(l0, l1)]
    l4 := l6
  }
  switch load(l4, 0) {
  arm 0:
    l7 := alloc [0, 0, l1]
    l3 := l7
  arm 1:
    l8 := load(l4, 1)
    l9 := alloc [0, l8, l0]
    l3 := l9
  }
  l2 := load(l3, 2)
  return l2
func flagPick (flag, nat, nat) -> nat, 4 locals, 0 heap words
  if l0 {
    l3 := l1
  } else {
    l3 := l2
  }
  return l3
