-- An existential payload can hide State from a scan of literal family names.
state State := makeState history (earned : Nat)
def init : State := makeState 0
def boxed : Sigma (A : Type 0) A := pack State init
def bump : State -> State := fun (s : State) => makeState (natAdd (earned s) 1)
def reset : State -> State := fun (s : State) => payload boxed
