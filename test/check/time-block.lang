-- REFUSE_TIME (S3, O3): `block` is a time word. A program counts operations:
-- a position is `len r` (an OpPos). This row was the example
-- examples/blocks.lang (slice S8, O17).
state State := makeState (seen : Nat)
def init : State := makeState 0
def stamp : State -> State := fun (s : State) => makeState (block s)
